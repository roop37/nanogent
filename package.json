{
  "name": "nanogent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "bash scripts/check.sh",
    "sandbox:build": "docker build -t nanogent-sandbox:dev packages/sandbox/docker",
    "nanogent": "pnpm build && node apps/cli/dist/bin.js",
    "test:docker": "pnpm build && pnpm --filter @nanogent/cli exec vitest run --config vitest.docker.config.ts && pnpm --filter @nanogent/evals exec vitest run --config vitest.docker.config.ts",
    "eval": "pnpm build && node apps/cli/dist/bin.js eval"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/node": "24.12.0",
    "turbo": "2.8.17",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
