{
  "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["evals/tasks/**", "evals/baseline/**"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "evals/baseline/slug-counter-fork/repo/**",
        "evals/baseline/slug-counter-fork/solution/**"
      ],
      "formatter": { "enabled": false },
      "assist": { "enabled": false }
    },
    {
      "includes": ["apps/web/**/*.css"],
      "css": {
        "parser": {
          "tailwindDirectives": true
        }
      }
    }
  ]
}
